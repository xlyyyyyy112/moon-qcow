///|
/// Independently constructed small QCOW2 fixtures. Real QEMU fixtures are
/// generated by scripts/interop.py and are compared against a RAW oracle.
fn put(
  data : Array[Byte],
  offset : Int32,
  width : Int32,
  value : UInt64,
) -> Unit {
  for i = 0; i < width; i = i + 1 {
    data[offset + i] = ((value >> ((width - i - 1) * 8)) & 255UL).to_byte()
  }
}

///|
fn fixture(bits~ : Int32 = 9, version~ : Int32 = 3) -> Array[Byte] {
  let cluster = 1 << bits
  let data = Array::make(cluster * 6, b'\x00')
  put(data, 0, 4, 0x514649fbUL)
  put(data, 4, 4, version.to_uint64())
  put(data, 20, 4, bits.to_uint64())
  put(data, 24, 8, (cluster * 2).to_uint64())
  put(data, 36, 4, 1UL)
  put(data, 40, 8, (cluster * 3).to_uint64())
  put(data, 48, 8, cluster.to_uint64())
  put(data, 56, 4, 1UL)
  put(data, 96, 4, 4UL)
  put(data, 100, 4, 104UL)
  put(data, cluster, 8, (cluster * 2).to_uint64())
  for i = 0; i < 6; i = i + 1 {
    put(data, cluster * 2 + i * 2, 2, 1UL)
  }
  put(data, cluster * 3, 8, (cluster * 4).to_uint64() | 0x8000000000000000UL)
  put(data, cluster * 4, 8, (cluster * 5).to_uint64() | 0x8000000000000000UL)
  for i = cluster * 5; i < cluster * 6; i = i + 1 {
    data[i] = (i % 251).to_byte()
  }
  data
}

///|
fn fails(action : () -> Unit raise QcowError) -> Bool {
  try {
    action()
    false
  } catch {
    _ => true
  }
}

///|
fn image_fixture() -> Image raise QcowError {
  open(Bytes::from_array(fixture()))
}

///|
test "v2 and v3 exact and cross-cluster reads" {
  for version in [2, 3] {
    let data = fixture(version~)
    let image = open(Bytes::from_array(data))
    assert_eq(image.virtual_size(), 1024UL)
    assert_eq(image.cluster_size(), 512)
    let read = image.read_at(499UL, 30)
    for i = 0; i < 13; i = i + 1 {
      assert_eq(read[i], data[5 * 512 + 499 + i])
    }
    for i = 13; i < 30; i = i + 1 {
      assert_eq(read[i], b'\x00')
    }
  }
}

///|
test "zero-length reads at EOF and invalid logical ranges" {
  let image = image_fixture()
  assert_eq(image.read_at(1024UL, 0), b"")
  assert_true(fails(() => ignore(image.read_at(1024UL, 1))))
  assert_true(fails(() => ignore(image.read_at(0xffffffffffffffffUL, 1))))
  assert_true(fails(() => ignore(image.read_at(0UL, -1))))
  assert_true(fails(() => ignore(image.read_at(0UL, 16777217))))
}

///|
test "short source callbacks are rejected" {
  let source = Source::new(8UL, fn(_, _) { b"x" })
  assert_true(fails(() => ignore(source.read_at(0UL, 8))))
  assert_eq(source.read_at(8UL, 0), b"")
  assert_true(fails(() => ignore(source.read_at(9UL, 0))))
}

///|
test "bad magic version cluster size and encryption are rejected" {
  for
    (offset, width, value) in [
      (0, 4, 0UL),
      (4, 4, 4UL),
      (20, 4, 8UL),
      (20, 4, 22UL),
      (32, 4, 2UL),
    ] {
    let data = fixture()
    put(data, offset, width, value)
    assert_true(fails(() => ignore(open(Bytes::from_array(data)))))
  }
}

///|
test "v3 incompatible flags never silently fall back" {
  for bit in [0, 1, 2, 3, 5, 63] {
    let data = fixture()
    put(data, 72, 8, 1UL << bit)
    assert_true(fails(() => ignore(open(Bytes::from_array(data)))))
  }
}

///|
test "invalid header and L1 locations" {
  for
    (offset, width, value) in [
      (100, 4, 103UL),
      (100, 4, 520UL),
      (40, 8, 511UL),
      (40, 8, 0UL),
      (36, 4, 0UL),
      (48, 8, 5UL),
      (56, 4, 0UL),
    ] {
    let data = fixture()
    put(data, offset, width, value)
    assert_true(fails(() => ignore(open(Bytes::from_array(data)))))
  }
}

///|
test "unallocated zero override suppresses backing" {
  let data = fixture()
  put(data, 8, 8, 200UL)
  put(data, 16, 4, 1UL)
  data[200] = b'b'
  let backing = Raw(Source::from_bytes(Bytes::make(1024, b'Z')))
  let image = open(Bytes::from_array(data), backing~)
  assert_eq(image.read_at(512UL, 3), b"ZZZ")
  put(data, 4 * 512 + 8, 8, 1UL)
  let zero = open(Bytes::from_array(data), backing~)
  assert_eq(zero.read_at(512UL, 3), b"\x00\x00\x00")
  assert_true(zero.resolve_at(512UL).kind is Zero)
}

///|
test "missing backing is an error not zero-filled success" {
  let data = fixture()
  put(data, 8, 8, 200UL)
  put(data, 16, 4, 1UL)
  assert_true(fails(() => ignore(open(Bytes::from_array(data)))))
  assert_true(
    fails(() => {
      ignore(
        open(Bytes::from_array(fixture()), backing=Raw(Source::from_bytes(b""))),
      )
    }),
  )
}

///|
test "short RAW backing EOF is zero-filled" {
  let data = fixture()
  put(data, 8, 8, 200UL)
  put(data, 16, 4, 1UL)
  let image = open(
    Bytes::from_array(data),
    backing=Raw(Source::from_bytes(Bytes::make(514, b'A'))),
  )
  assert_eq(image.read_at(512UL, 4), b"AA\x00\x00")
  let resolved = image.resolved_map(512UL, 4UL)
  assert_eq(resolved.length(), 2)
  assert_eq(resolved[0].length, 2UL)
  assert_true(resolved[1].kind is Zero)
}

///|
test "reserved L1 L2 and unaligned data pointers reject on access" {
  for
    (offset, value) in [
      (3 * 512, 1UL),
      (3 * 512, 513UL),
      (4 * 512, 2UL),
      (4 * 512, 512UL + 512UL / 2UL),
      (4 * 512, 0x8000000000000000UL),
    ] {
    let data = fixture()
    put(data, offset, 8, value)
    let image = open(Bytes::from_array(data))
    assert_true(fails(() => ignore(image.read_at(0UL, 1))))
  }
}

///|
test "extended L2 allocation zero and fallthrough" {
  let cluster = 16384
  let data = fixture(bits=14)
  put(data, 72, 8, 16UL)
  put(data, 4 * cluster + 8, 8, 1UL | (2UL << 32))
  let image = open(Bytes::from_array(data))
  assert_eq(image.read_at(0UL, 1)[0], data[5 * cluster])
  assert_eq(image.read_at(512UL, 2), b"\x00\x00")
  assert_true(image.extent_at(512UL).kind is Zero)
  assert_true(image.extent_at(1024UL).kind is Unallocated)
  put(data, 4 * cluster + 8, 8, 1UL | (1UL << 32))
  let invalid = open(Bytes::from_array(data))
  assert_true(fails(() => ignore(invalid.read_at(0UL, 1))))
}

///|
test "compressed raw DEFLATE roundtrip and output limit" {
  let data = fixture()
  let payload = Bytes::make(512, b'Q')
  let compressed = @flate.deflate_all(payload[:])
  for i = 0; i < compressed.length(); i = i + 1 {
    data[5 * 512 + i] = compressed[i]
  }
  put(data, 4 * 512, 8, 0x4000000000000000UL | (5 * 512).to_uint64())
  let image = open(Bytes::from_array(data))
  assert_eq(image.read_at(13UL, 201), Bytes::make(201, b'Q'))
  assert_true(image.extent_at(0UL).kind is Compressed)
  let wrong = @flate.deflate_all(Bytes::make(513, b'Q')[:])
  for i = 0; i < wrong.length(); i = i + 1 {
    data[5 * 512 + i] = wrong[i]
  }
  let invalid = open(Bytes::from_array(data))
  assert_true(fails(() => ignore(invalid.read_at(0UL, 1))))
}

///|
test "copy cursor failure leaves failed chunk retryable" {
  let image = image_fixture()
  let cursor = image.copy_cursor(0UL, 1024UL, chunk_size=100)
  let mut calls = 0
  assert_true(
    fails(() => {
      ignore(
        cursor.step(3, (_, _) => {
          calls = calls + 1
          if calls == 2 {
            raise Io("injected")
          }
        }),
      )
    }),
  )
  assert_eq(cursor.progress().next_offset, 100UL)
  assert_eq(cursor.progress().written_bytes, 100UL)
  let offsets : Array[UInt64] = []
  ignore(cursor.step(100, fn(offset, _) { offsets.push(offset) }))
  assert_eq(offsets[0], 100UL)
  assert_true(cursor.progress().complete)
  assert_eq(cursor.progress().written_bytes, 1024UL)
}

///|
test "sparse copy skips zeros only and cancellation is incomplete" {
  let image = image_fixture()
  let mut written = 0
  let result = image.copy_to(
    fn(_, bytes) { written = written + bytes.length() },
    chunk_size=512,
    sparse=true,
  )
  assert_eq(written, 512)
  assert_eq(result.skipped_zero_bytes, 512UL)
  let cancelled = image.copy_to(fn(_, _) { () }, cancelled=fn() { true })
  assert_true(!cancelled.complete)
  assert_eq(cancelled.next_offset, 0UL)
}

///|
test "stream EOF and seek preserve position on failure" {
  let reader = image_fixture().reader(499UL, 30UL)
  assert_eq(reader.read(100).length(), 30)
  assert_eq(reader.read(5), b"")
  assert_true(fails(() => reader.seek(31UL)))
  assert_eq(reader.position(), 30UL)
  reader.seek(0UL)
  assert_eq(reader.remaining(), 30UL)
}

///|
test "map index preserves ownership and clips physical addresses" {
  let image = image_fixture()
  let records = image.map_range(0UL, 1024UL)
  let index = MapIndex::new(1024UL, records[:])
  records.clear()
  assert_eq(index.record_count(), 2)
  assert_eq(index.lookup(500UL).physical, Some(5UL * 512UL + 500UL))
  let selected = index.query(500UL, 24UL)
  assert_eq(selected.length(), 2)
  assert_eq(selected[0].length, 12UL)
  let copy = index.records()
  copy.clear()
  assert_eq(index.record_count(), 2)
  assert_eq(index.stored_plan().total_bytes(), 512UL)
  assert_eq(index.unallocated_plan().total_bytes(), 512UL)
}

///|
test "map index rejects incomplete and malformed caller maps" {
  let record : Extent = {
    offset: 0UL,
    length: 4UL,
    kind: Data,
    physical: None,
    stored_length: 0,
  }
  assert_true(fails(() => ignore(MapIndex::new(4UL, [record][:]))))
  assert_true(fails(() => ignore(MapIndex::new(4UL, [][:]))))
  assert_eq(MapIndex::new(0UL, [][:]).record_count(), 0)
}

///|
test "exact refcount check detects leaked and missing allocations" {
  let data = fixture()
  let image = open(Bytes::from_array(data))
  assert_true(image.check_refcounts().ok())
  put(data, 2 * 512 + 5 * 2, 2, 0UL)
  let invalid = open(Bytes::from_array(data))
  assert_true(!invalid.check_refcounts().ok())
  assert_true(!invalid.audit().ok())
}

///|
test "refcount packed widths follow low bits within a byte" {
  for order in [0, 1, 2, 3, 4, 5, 6] {
    let data = fixture()
    put(data, 96, 4, order.to_uint64())
    data[2 * 512] = b'\x55'
    let image = open(Bytes::from_array(data))
    let count = image.refcount_at(0UL)
    if order == 0 {
      assert_eq(count, 1UL)
    }
    if order == 1 {
      assert_eq(count, 1UL)
    }
    if order == 2 {
      assert_eq(count, 5UL)
    }
    if order == 3 {
      assert_eq(count, 85UL)
    }
    if order == 4 {
      assert_eq(count, 21761UL)
    }
    if order == 5 {
      assert_eq(count, 1426128897UL)
    }
    if order == 6 {
      assert_eq(count, 0x5501000100010001UL)
    }
  }
}

///|
test "metadata and data overlap is visible to audit" {
  let data = fixture()
  put(data, 4 * 512, 8, (3 * 512).to_uint64())
  let image = open(Bytes::from_array(data))
  assert_true(!image.audit().ok())
  assert_true(image.metadata_size() > 0UL)
  assert_eq(image.metadata_at(0UL).length(), 1)
}

///|
test "backup plan set operations and ownership" {
  let input : Array[Difference] = [
    { offset: 10UL, length: 20UL, },
    { offset: 20UL, length: 20UL, },
  ]
  let plan = BackupPlan::new(100UL, input[:])
  input.clear()
  assert_eq(plan.total_bytes(), 30UL)
  assert_true(plan.contains(10UL) && !plan.contains(40UL))
  let other_ranges : Array[Difference] = [{ offset: 20UL, length: 30UL, }]
  let other = BackupPlan::new(100UL, other_ranges[:])
  assert_eq(plan.intersection(other).total_bytes(), 20UL)
  assert_eq(plan.union(other).total_bytes(), 40UL)
  assert_eq(plan.subtract(other).total_bytes(), 10UL)
  assert_eq(plan.complement().total_bytes(), 70UL)
  assert_eq(plan.window(0UL, 20UL).total_bytes(), 10UL)
  assert_eq(plan.chunk_count(7UL), 5UL)
  let copy = plan.ranges()
  copy.clear()
  assert_eq(plan.ranges().length(), 1)
}

///|
test "selected backup cursor writes only selected addresses" {
  let image = image_fixture()
  let selected : Array[Difference] = [
    { offset: 1UL, length: 3UL, },
    { offset: 513UL, length: 2UL, },
  ]
  let plan = BackupPlan::new(1024UL, selected[:])
  let cursor = image.backup_cursor(plan, chunk_size=2)
  let offsets : Array[UInt64] = []
  let progress = cursor.step(20, fn(offset, _) { offsets.push(offset) })
  assert_true(progress.complete)
  assert_eq(progress.copied_bytes, 5UL)
  assert_eq(offsets, [1UL, 3UL, 513UL])
}

///|
test "comparison truncation cannot report equality" {
  let image = image_fixture()
  let raw = image.read_at(0UL, 1024)
  assert_eq(image.compare_raw(Source::from_bytes(raw)).different_bytes, 0UL)
  let expected = Array::make(1024, b'\x00')
  let report = image.compare_raw(
    Source::from_bytes(Bytes::from_array(expected)),
    max_ranges=1,
  )
  assert_true(!report.complete)
  assert_true(report.different_bytes > 0UL)
}

///|
test "range helpers reject overflow and align changed blocks" {
  assert_true(fails(() => ignore(add(0xffffffffffffffffUL, 1UL))))
  assert_true(fails(() => ignore(multiply(0xffffffffffffffffUL, 2UL))))
  let range : ByteRange = { offset: 1UL, length: 100UL, }
  assert_eq(range.split(30UL, 4).length(), 4)
  let changed : Array[Difference] = [{ offset: 513UL, length: 1UL, }]
  let blocks = dirty_blocks(changed[:], 512UL, 1000UL)
  assert_eq(blocks[0].offset, 512UL)
  assert_eq(blocks[0].length, 488UL)
}

///|
test "sector and subdevice bounds" {
  let image = image_fixture()
  let device = image.block_device()
  assert_eq(device.sector_count(), 2UL)
  assert_eq(device.read_sectors(0UL, 1), image.read_at(0UL, 512))
  let slice = device.slice(1UL, 1UL)
  assert_eq(slice.read_sectors(0UL, 1), Bytes::make(512, b'\x00'))
  assert_true(fails(() => ignore(slice.read_sectors(1UL, 1))))
  assert_true(fails(() => ignore(image.block_device(sector_size=513))))
}

///|
test "source slicing concatenation and batch read order" {
  let a = Source::from_bytes(b"abc")
  let b = Source::from_bytes(b"defg")
  let joined = concatenate_sources([a, Source::from_bytes(b""), b][:])
  assert_eq(joined.read_at(1UL, 5), b"bcdef")
  assert_eq(joined.slice(2UL, 3UL).read_at(0UL, 3), b"cde")
  let ranges : Array[ByteRange] = [
    { offset: 512UL, length: 2UL, },
    { offset: 0UL, length: 1UL, },
  ]
  let image = image_fixture()
  let reads = image.read_many(ranges[:])
  assert_eq(reads[0], b"\x00\x00")
  assert_eq(reads[1], image.read_at(0UL, 1))
  assert_true(fails(() => ignore(image.read_many(ranges[:], max_total=2UL))))
}

///|
test "cache budget eviction and hit counters" {
  let data = Bytes::from_array(fixture())
  let limits = { ..Limits::default(), cache_bytes: 512, }
  let image = open(data, limits~)
  ignore(image.read_at(0UL, 1))
  ignore(image.read_at(1UL, 1))
  assert_true(image.cache_stats().hits > 0UL)
  assert_true(image.cache_stats().bytes <= 512)
  image.clear_cache()
  assert_eq(image.cache_stats().bytes, 0)
  assert_eq(image.cache_stats().hits, 0UL)
  let cache = BlockCache::new(2)
  let source = Source::from_bytes(b"abcdef")
  assert_eq(cache.read(source, 0UL, 2), b"ab")
  assert_eq(cache.read(source, 2UL, 2), b"cd")
  assert_eq(cache.blocks.length(), 1)
}

///|
test "source metrics count physical reads and failures" {
  let metrics = SourceMetrics::new()
  let source = metrics.wrap(Source::from_bytes(b"abc"))
  assert_eq(source.read_at(0UL, 2), b"ab")
  assert_eq(metrics.reads, 1UL)
  assert_eq(metrics.bytes, 2UL)
  let broken = metrics.wrap(Source::new(1UL, (_, _) => raise Io("test")))
  assert_true(fails(() => ignore(broken.read_at(0UL, 1))))
  assert_eq(metrics.failed, 1UL)
  metrics.reset()
  assert_eq(metrics.reads, 0UL)
}

///|
test "size parser is unsigned precise and bounded" {
  assert_eq(parse_size("1KiB"), 1024UL)
  assert_eq(parse_size("0xff"), 255UL)
  assert_eq(parse_size("18446744073709551615"), 0xffffffffffffffffUL)
  for
    invalid in [
      "", "-1", "+1", " 1", "0x", "1KB", "18446744073709551616", "0x10000000000000000",
      "18446744073709551615KiB",
    ] {
    assert_true(fails(() => ignore(parse_size(invalid))))
  }
  assert_eq(hex_offset(0xffffffffffffffffUL), "ffffffffffffffff")
  assert_true(hexdump(b"abc\x00"[:]).contains("abc."))
}
